# Local development secrets. Copy this file to .env and replace placeholders.
# Never commit the copied .env file.
Jwt__Issuer=VeganHelper.API
Jwt__Audience=VeganHelper.Client
Jwt__SigningKey=replace-with-a-random-secret-at-least-32-characters
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7
Cors__AllowedOrigins__0=http://localhost:3000

SendGrid__ApiKey=replace-with-sendgrid-api-key
SendGrid__FromEmail=verified-sender@example.com
SendGrid__FromName=VeganHelper
Google__ClientId=replace-with-google-client-id

# PayOS credentials belong on the Backend only; never expose them to Frontend.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=http://localhost:3000/meal-plans/payment/success
PayOS__CancelUrl=http://localhost:3000/meal-plans/payment/cancel

# AI Genie calls DeepSeek from the Backend only; do not expose this key to Frontend.
DeepSeekChat__Enabled=true
DeepSeekChat__ApiKey=replace-with-deepseek-api-key
DeepSeekChat__Model=deepseek-flash
DeepSeekChat__TimeoutSeconds=45
DeepSeekChat__MaxOutputTokens=1024
DeepSeekChat__MaxInputCharacters=30000
DeepSeekChat__Temperature=0.2

CloudflareR2__BucketName=replace-with-r2-bucket
CloudflareR2__AccessKey=replace-with-r2-access-key
CloudflareR2__SecretKey=replace-with-r2-secret-key
CloudflareR2__ServiceUrl=https://replace-with-account-id.r2.cloudflarestorage.com
CloudflareR2__PublicUrl=https://replace-with-public-media-host

# Groq key stays on Backend. FFmpeg is optional when R2 video URLs are public.
GroqSummary__Enabled=false
GroqSummary__ApiKey=
GroqSummary__WhisperModel=whisper-large-v3-turbo
GroqSummary__SummaryModel=openai/gpt-oss-20b
GroqSummary__FfmpegPath=ffmpeg
Storage__AvatarRoot=wwwroot/uploads/avatars
AllowedHosts=*
